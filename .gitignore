# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
test-results/
playwright-report/

# next.js
/.next/
/out/

# production
/build

# local scripts (admin utilities, one-offs)
/scripts/
start.bat
checkapi.bat

# local CRM drafts / prototypes
/crm/docs/

# API lives in a separate repo (Rosecrest-Group/crm-api)
/api/
/api-temp/

# misc
.DS_Store
*.pem
.cursor/
docs.zip
workflowdocs/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
